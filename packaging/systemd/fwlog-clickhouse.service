[Unit]
Description=FWLog Embedded ClickHouse
Documentation=https://clickhouse.com/docs
After=network-online.target
Wants=network-online.target
Before=fwlog.service
PartOf=fwlog.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/fwlog/clickhouse
ExecStartPre=/usr/bin/install -d -m 0755 /opt/fwlog/clickhouse/data /opt/fwlog/clickhouse/tmp /opt/fwlog/clickhouse/user_files /opt/fwlog/clickhouse/format_schemas /opt/fwlog/clickhouse/log
ExecStart=/opt/fwlog/clickhouse/bin/clickhouse server --config-file=/opt/fwlog/clickhouse/etc/config.xml
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=5
LimitNOFILE=262144
LimitNPROC=65536
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fwlog-clickhouse

[Install]
WantedBy=multi-user.target
